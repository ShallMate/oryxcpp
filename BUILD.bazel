load("//bazel:yacl.bzl", "yacl_cc_binary", "yacl_cc_library")

package(default_visibility = ["//visibility:public"])

yacl_cc_library(
    name = "spdz_mpc",
    srcs = ["spdz_mpc.cc"],
    hdrs = ["spdz_mpc.h"],
    deps = [
        "//yacl/base:exception",
        "//yacl/base:int128",
        "//yacl/link:context",
        "//yacl/math/mpint",
    ],
)

yacl_cc_library(
    name = "ec_mpc",
    srcs = ["ec_mpc.cc"],
    hdrs = ["ec_mpc.h"],
    deps = [
        ":spdz_mpc",
        "//yacl/base:exception",
        "//yacl/base:int128",
        "//yacl/crypto/ecc",
        "//yacl/crypto/ecc:spi",
        "//yacl/link:context",
        "//yacl/math/mpint",
        "//yacl/utils:serialize",
    ],
)

yacl_cc_library(
    name = "pii",
    srcs = ["pii_mpc.cc"],
    hdrs = ["pii.h"],
    deps = [
        ":spdz_mpc",
        "//yacl/base:int128",
        "//yacl/crypto/hash:hash_utils",
        "//yacl/math/mpint",
        "//yacl/utils/spi:type_traits",
    ],
)

yacl_cc_binary(
    name = "pii_demo",
    srcs = ["main.cc"],
    deps = [
        ":pii",
        "//yacl/crypto/hash:hash_interface",
        "//yacl/link:test_util",
    ],
)

yacl_cc_binary(
    name = "fp_mpc_test",
    srcs = ["fp_mpc_test.cc"],
    deps = [
        ":spdz_mpc",
        "//yacl/base:exception",
        "//yacl/link:test_util",
        "//yacl/utils/spi:type_traits",
    ],
)

yacl_cc_binary(
    name = "ec_mpc_test",
    srcs = ["ec_mpc_test.cc"],
    deps = [
        ":ec_mpc",
        ":spdz_mpc",
        "//yacl/base:exception",
        "//yacl/crypto/ecc",
        "//yacl/crypto/ecc:spi",
        "//yacl/link:test_util",
    ],
)

yacl_cc_library(
    name = "pairing_mpc",
    srcs = ["pairing_mpc.cc"],
    hdrs = ["pairing_mpc.h"],
    deps = [
        ":ec_mpc",
        ":spdz_mpc",
        "//yacl/base:exception",
        "//yacl/crypto/pairing",
        "//yacl/link:context",
        "//yacl/math/galois_field:gf",
        "//yacl/math/mpint",
        "//yacl/utils:serialize",
    ],
)

yacl_cc_binary(
    name = "pairing_mpc_test",
    srcs = ["pairing_mpc_test.cc"],
    deps = [
        ":ec_mpc",
        ":pairing_mpc",
        ":spdz_mpc",
        "//yacl/base:exception",
        "//yacl/crypto/pairing",
        "//yacl/crypto/pairing/factory:mcl_factory",
        "//yacl/crypto/pairing/factory:spi",
        "//yacl/link:test_util",
    ],
)
